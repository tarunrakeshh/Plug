
{
  "name": "plugged-root",
  "version": "1.0.0",
  "description": "PLUGGED - India-only EV Charging Platform (PlugShare-inspired)",
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "seed": "npm run seed:osm --",
    "seed:osm": "npm --prefix backend run seed:osm --",
    "import:india": "npm --prefix backend run import:india --",
    "import:stations": "npm --prefix backend run import:stations --",
    "enrich:stations": "npm --prefix backend run enrich:stations --",
    "validate:stations": "npm --prefix backend run validate:stations",
    "report:stations": "npm --prefix backend run report:stations",
    "export:stations": "npm --prefix backend run export:stations",
    "test": "npm --prefix backend run test",
    "verify:db": "npm --prefix backend run verify:db"
  },
  "keywords": [
    "ev",
    "charging",
    "india",
    "leaflet",
    "express",
    "mongodb"
  ],
  "author": "PLUGGED Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
